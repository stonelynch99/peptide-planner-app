{
  "expo": {
    "name": "EZPep Planner",
    "slug": "ezpep-planner",
    "owner": "full-force-studios",
    "extra": {
      "eas": {
        "projectId": "2afce2f0-02c2-47db-a03a-d7bb0888b59f"
      }
    },
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.ezpep.planner",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./public/favicon.png"
    },
    "experiments": {
      "baseUrl": ""
    },
    "scheme": "ezpepplanner"
  }
}
